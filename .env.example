# Claude Code 通知配置
CLAUDE_CODE_BOT_TOKEN=your_claude_code_bot_token
CLAUDE_CODE_CHAT_ID=your_claude_code_chat_id

# OpenAI Codex 通知配置
CODEX_BOT_TOKEN=your_codex_bot_token
CODEX_CHAT_ID=your_codex_chat_id

# OpenClaw 通知配置
OPENCLAW_BOT_TOKEN=your_openclaw_bot_token
OPENCLAW_CHAT_ID=your_openclaw_chat_id

# AI 翻译配置（通过 LiteLLM 使用 OpenRouter）
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openrouter/deepseek/deepseek-v4-flash-0731

# 可选：固定 OpenRouter provider（逗号分隔），避免多 provider 路由导致的翻译质量方差
LLM_PROVIDER_ONLY=fireworks,deepinfra,together

# GitHub API 配置（可选，用于访问 GitHub API 避免速率限制）
# 注意：不要使用 GITHUB_TOKEN，这是 GitHub Actions 的保留变量
# GH_TOKEN=your_github_personal_access_token

# Telegraph 长文发布配置（可选，超长更新日志会发布到 Telegraph）
# TELEGRAPH_ACCESS_TOKEN=your_telegraph_access_token
